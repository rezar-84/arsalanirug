      { term: "Kenareh", fa: "کناره", text: "باریکه‌بافِ راهروها و کناره‌های چیدمان سنتی اتاق ایرانی." },
      { term: "Shesh Metri", fa: "شش‌متری", text: "قواره سخاوتمند ۳ در ۲ متر که میهمان‌خانه ایرانی بر آن بنا می‌شود." },
      { term: "Dastbaf", fa: "دستباف", text: "همان یک واژه که هرچه در این خانه است را از هرچه ماشین بافته جدا می‌کند." },
    ],
  },
};

const c = content[locale] ?? content.en!;
const featuredRegions = regionRegistry.filter((r) => r.featured);
---

<BaseLayout
  locale={locale}
  path="/guide"
  title={`${c.title} — ${ui.siteName}`}
  description={c.intro.slice(0, 155)}
>
  <section class="mx-auto max-w-[800px] px-6 pt-16 text-center">
    <p class="text-xs uppercase tracking-[0.3em] text-saffron" data-reveal>{c.kicker}</p>
    <h1 class="font-display-lang mt-4 text-5xl md:text-6xl" data-reveal>{c.title}</h1>
    <Motif variant="divider" class="mt-6 text-espresso/25" data-reveal />
    <p class="mt-8 text-start text-base leading-loose text-espresso/90" data-reveal>{c.intro}</p>
  </section>

  <!-- Designs -->
  <section class="mx-auto max-w-[1100px] px-6 pt-20">
    <h2 class="font-display-lang text-center text-4xl" data-reveal>{c.designTitle}</h2>
    <p class="mx-auto mt-4 max-w-xl text-center text-sm leading-relaxed text-espresso/80" data-reveal>
      {c.designIntro}
    </p>
    <div class="mt-14 grid gap-x-12 gap-y-12 md:grid-cols-2">
      {c.designs.map((d) => (
        <div class="border-s-2 border-saffron/40 ps-6" data-reveal>
          <div class="flex flex-wrap items-baseline gap-x-4">
            <h3 class="font-display text-3xl" lang="en">{d.term}</h3>
            <span class="font-fa-display text-2xl text-crimson" lang="fa" dir="rtl">{d.fa}</span>
          </div>
          <p class="mt-3 text-sm leading-loose text-espresso/90">{d.text}</p>
        </div>
      ))}
    </div>
  </section>

  <!-- Cities: Qom & Kashan featured -->
  <section class="mx-auto max-w-[1100px] px-6 pt-24">
    <h2 class="font-display-lang text-center text-4xl" data-reveal>{c.citiesTitle}</h2>
    <Motif variant="divider" class="mt-6 text-espresso/25" data-reveal />
    <p class="mx-auto mt-6 max-w-xl text-center text-sm leading-relaxed text-espresso/80" data-reveal>
      {c.citiesIntro}
    </p>
    <div class="mt-14 grid gap-8 md:grid-cols-2">
      {featuredRegions.map((region) => (
        <a
          href={localizedPath(locale, `/regions/${region.slug}`)}
          class="group relative overflow-hidden rounded-3xl border border-espresso/25 bg-card p-8 transition-colors hover:border-crimson/50"
          data-reveal
        >
          <Motif variant="medallion" class="pointer-events-none absolute -end-20 -top-20 h-64 w-64 text-espresso/[0.07]" />
          <p class="text-xs uppercase tracking-[0.25em] text-saffron">{regionKicker(region, locale)}</p>
          <div class="mt-2 flex items-baseline gap-4">
            <h3 class="font-display-lang text-4xl transition-colors group-hover:text-crimson">{regionName(region, locale)}</h3>
            {locale !== "fa" && region.name.fa && (
              <span class="font-fa-display text-3xl text-crimson" lang="fa" dir="rtl">{region.name.fa}</span>
            )}
          </div>
          {regionBody(region, locale).map((p) => (
            <p class="mt-4 text-sm leading-loose text-espresso/90">{p}</p>
          ))}
        </a>
      ))}
    </div>
    <div class="mt-10">
      <RegionTiles locale={locale} compact />
    </div>
  </section>

  <!-- Quality -->
  <section class="px-4 pt-24">
    <div class="relative mx-auto max-w-[1100px] overflow-hidden rounded-[2.5rem] bg-bitter px-8 py-16 text-canvas">
      <Motif variant="medallion" class="pointer-events-none absolute -bottom-32 -start-32 h-96 w-96 text-canvas/[0.05]" />
      <h2 class="font-display-lang text-center text-4xl" data-reveal>{c.qualityTitle}</h2>
      <p class="mt-4 text-center text-sm text-canvas/70" data-reveal>{c.qualityIntro}</p>
      <ol class="relative mx-auto mt-12 grid max-w-[900px] gap-10">
        {c.quality.map((q, i) => (
          <li class="grid grid-cols-[3rem_1fr] items-start gap-5" data-reveal>
            <span class="font-display flex h-12 w-12 items-center justify-center rounded-full border border-saffron/50 text-xl text-saffron">
              {(i + 1).toLocaleString(locale === "fa" ? "fa-IR" : "en-US")}
            </span>
            <div>
              <h3 class="font-display-lang text-2xl">{q.title}</h3>
              <p class="mt-2 text-sm leading-loose text-canvas/80">{q.text}</p>
            </div>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- Traditional sizes, to scale -->
  <section class="mx-auto max-w-[1100px] px-6 pt-24">
    <h2 class="font-display-lang text-center text-4xl" data-reveal>{ui.explore.sizeGuideTitle}</h2>
    <Motif variant="divider" class="mt-6 text-espresso/25" data-reveal />
    <p class="mx-auto mt-6 max-w-xl text-center text-sm leading-relaxed text-espresso/80" data-reveal>
      {ui.explore.sizeGuideIntro}
    </p>
    <div class="mt-12" data-reveal>
      <SizeGuide locale={locale} />
    </div>
  </section>

  <!-- Lexicon -->
  <section class="mx-auto max-w-[1100px] px-6 pt-24">
    <h2 class="font-display-lang text-center text-4xl" data-reveal>{c.lexiconTitle}</h2>
    <Motif variant="divider" class="mt-6 text-espresso/25" data-reveal />
    <p class="mx-auto mt-6 max-w-xl text-center text-sm leading-relaxed text-espresso/80" data-reveal>
      {c.lexiconIntro}
    </p>
    <div class="mt-14 columns-1 gap-10 md:columns-2 lg:columns-3">
      {c.lexicon.map((w) => (
        <div class="mb-10 break-inside-avoid text-center" data-reveal>
          <span class="font-fa-display block text-3xl leading-relaxed text-crimson" lang="fa" dir="rtl">{w.fa}</span>
          <span class="font-display mt-1 block text-lg tracking-wide" lang="en">{w.term}</span>
          <span class="mx-auto mt-3 block h-px w-10 bg-saffron/60"></span>
          <p class="mt-3 text-sm leading-loose text-espresso/85">{w.text}</p>
        </div>
      ))}
    </div>
  </section>

  <section class="mx-auto max-w-[700px] px-6 py-20 text-center" data-reveal>
    <p class="font-display-lang text-2xl leading-relaxed text-espresso">
      {locale === "en"
        ? "Now walk the collection with new eyes."
        : "اکنون با چشمانی تازه در مجموعه قدم بزنید."}
    </p>
    <div class="mt-8">
      <Button href={localizedPath(locale, "/products")} variant="primary">{ui.cta.viewCollection}</Button>
    </div>
  </section>
</BaseLayout>
