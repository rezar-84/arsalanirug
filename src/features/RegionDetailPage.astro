---
import BaseLayout from "../layouts/BaseLayout.astro";
import Motif from "../components/Motif.astro";
import RugCard from "../components/RugCard.astro";
import Button from "../components/Button.astro";
import { t, localizedPath, type Locale } from "../i18n/ui";
import { getRugsWithFallback, rugsByRegion } from "../lib/rugs";
import { regionName, regionKicker, regionBody, type Region } from "../data/regions";

interface Props {
  locale: Locale;
  region: Region;
}
const { locale, region } = Astro.props;
const ui = t(locale);
const rugs = rugsByRegion(await getRugsWithFallback(locale), region.slug);
const name = regionName(region, locale);
const site = Astro.site?.toString().replace(/\/$/, "") ?? "https://arsalanirug.com";

// The region's palette, aggregated from its rugs' extracted colors.
const palette = [...new Set(rugs.flatMap((r) => r.data.palette ?? []))].slice(0, 12);

const collectionLd = {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  name: `${name} — ${ui.siteName}`,
  url: `${site}${localizedPath(locale, `/regions/${region.slug}`)}`,
  description: regionBody(region, locale)[0]?.slice(0, 155),
  isPartOf: { "@type": "WebSite", name: "Arsalani Rug", url: site },
};
---

<BaseLayout
  locale={locale}
  path={`/regions/${region.slug}`}
  title={`${name} — ${ui.explore.regionsTitle} — ${ui.siteName}`}
  description={regionBody(region, locale)[0]?.slice(0, 155) ?? name}
  jsonLd={[collectionLd]}
>
  <section class="mx-auto max-w-[800px] px-6 pt-16 text-center">
    <p class="text-xs uppercase tracking-[0.3em] text-saffron" data-reveal>
      {regionKicker(region, locale)}
    </p>
    <div class="mt-4 flex items-baseline justify-center gap-4" data-reveal>
      <h1 class="font-display-lang text-5xl md:text-6xl">{name}</h1>
      {locale !== "fa" && region.name.fa && (
        <span class="font-fa-display text-4xl text-crimson" lang="fa" dir="rtl">{region.name.fa}</span>
      )}
    </div>
    <Motif variant="divider" class="mt-6 text-espresso/25" data-reveal />
    {regionBody(region, locale).map((p) => (
      <p class="mt-6 text-start text-sm leading-loose text-espresso/90" data-reveal>{p}</p>
    ))}
    {palette.length > 0 && (
      <div class="mt-8" data-reveal>
        <p class="text-xs uppercase tracking-[0.2em] text-espresso/50">{ui.explore.regionPalette}</p>
        <div class="mt-3 flex flex-wrap items-center justify-center gap-1.5" aria-hidden="true">
          {palette.map((hex) => (
            <span class="inline-block h-5 w-5 rounded-full border border-espresso/20" style={`background-color: ${hex}`} />
          ))}
        </div>
      </div>
    )}
  </section>

  <section class="mx-auto max-w-[1400px] px-6 py-16">
    {rugs.length > 0 && (
      <>
        <h2 class="font-display-lang text-center text-3xl" data-reveal>{ui.explore.fromRegion}</h2>
        <div class="mt-12 grid gap-x-6 gap-y-14 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4">
          {rugs.map((rug) => (
            <RugCard rug={rug} locale={locale} />
          ))}
        </div>
      </>
    )}
    <div class="mt-14 flex flex-wrap items-center justify-center gap-3" data-reveal>
      <Button href={localizedPath(locale, "/guide")} variant="outline">{ui.nav.guide}</Button>
      <Button href={localizedPath(locale, "/products")} variant="primary">{ui.cta.viewCollection}</Button>
    </div>
  </section>
</BaseLayout>
