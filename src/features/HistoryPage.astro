---
import BaseLayout from "../layouts/BaseLayout.astro";
import Button from "../components/Button.astro";
import Motif from "../components/Motif.astro";
import { t, localizedPath, type Locale } from "../i18n/ui";

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const ui = t(locale);

// A cultural history of the Persian rug — deliberately separate from the
// Arsalani family story on /about. Dates cross-checked against standard
// references (Hermitage/Pazyryk, V&A/Ardabil, UNESCO ICH 2010).
const content: Partial<Record<
  Locale,
  {
    kicker: string;
    title: string;
    intro: string;
    eras: { era: string; title: string; text: string }[];
    closingTitle: string;
    closing: string;
    toGuide: string;
  }
>> = {
  en: {
    kicker: "The Persian Rug",
    title: "A Woven History",
    intro:
      "Empires burned their libraries and dynasties fell, but the knot survived. For two and a half thousand years Iranians have written their gardens, their poetry and their cosmology into wool and silk — and carried that memory on their floors across every exile and every age. Follow the thread.",
    eras: [
      {
        era: "c. 400 BC · the steppe",
        title: "The Pazyryk Carpet",
        text: "The oldest knotted carpet known to the world was found frozen in a Siberian burial mound in 1949. Around two and a half millennia old, its border of horsemen and grazing deer is drawn with such assurance — in the manner of Achaemenid Persia — that scholars read it as proof of a craft already centuries mature. The very first surviving carpet is already a masterpiece.",
      },
      {
        era: "224–651 · Ctesiphon",
        title: "The Spring of Khosrow",
        text: "In the Sasanian palace at Ctesiphon lay the Baharestan — a garden woven for winter, its streams of silver thread, its blossoms of jewels, so a king could walk in spring while snow fell outside. When the palace fell in 637, the conquerors could not divide its beauty except by cutting it to pieces. The most famous carpet in history survives only as a story — and as the garden plan Persian weavers have redrawn ever since.",
      },
      {
        era: "8th–15th c. · bazaar & caravan",
        title: "Memory in the Weave",
        text: "Through conquests and dynasties, weaving moved between court, village and nomad tent. The arabesque — the eslimi — entered the vocabulary; the boteh, the cypress, the tree of life travelled from fire-temple iconography into wool. When books were burned, the motifs kept their meanings; a rug is a text that cannot easily be confiscated.",
      },
      {
        era: "1501–1736 · Safavid Isfahan",
        title: "The Golden Age",
        text: "The Safavid shahs raised carpet weaving from craft to imperial art, with royal workshops in Isfahan, Kashan and Tabriz. Its supreme surviving witness is the Ardabil Carpet of 1539 — thirty-odd square metres of prayer-hall sky now in London's Victoria and Albert Museum, signed humbly by Maqsud Kashani, 'a servant of the court'. It is the oldest carpet in the world to carry its date woven into its own border.",
      },
      {
        era: "19th c. · Kashan",
        title: "Revival and the Manchester Thread",
        text: "After decades of decline, Kashan's master workshops — Mohtasham above all — led a renaissance of the classical style. Their luminous wool was spun from imported merino fleece by way of Manchester's mills, and 'Manchester Kashan' became a name collectors whisper. Two rugs of this very lineage live in our own collection.",
      },
      {
        era: "1930s · Qom",
        title: "The Youngest Master City",
        text: "Qom is the paradox of the Persian rug: a weaving city barely a century old that climbed straight to the summit. Weavers arriving from Kashan seeded workshops that chose the hardest road — silk on silk, knot counts beyond a thousand per square inch — until 'Qom silk' became the measure by which fineness itself is judged.",
      },
      {
        era: "2010 · the world",
        title: "Heritage of Humanity",
        text: "UNESCO inscribed the traditional carpet-weaving skills of Kashan and of Fars on the list of the Intangible Cultural Heritage of Humanity. What a grandmother taught at the loom is now protected the way cathedrals and symphonies are. The knot that outlived empires has become, officially, a treasure of everyone.",
      },
    ],
    closingTitle: "Why it endures",
    closing:
      "Persia was invaded, renamed, partitioned and sanctioned — and through all of it the rug kept working quietly as the nation's portable homeland. It holds the garden when there is no garden, the spring when it is winter, and the names of motifs whose first tellers are three thousand years gone. To own one is to hold a thread of that unbroken line.",
    toGuide: "Learn to read the rugs",
  },
  fa: {
    kicker: "فرش ایرانی",
    title: "تاریخِ بافته",
    intro:
      "امپراتوری‌ها کتابخانه‌هایشان را سوزاندند و سلسله‌ها فروریختند، اما گره ماند. ایرانیان دو هزار و پانصد سال است که باغ‌ها، شعر و جهان‌بینی‌شان را در پشم و ابریشم می‌نویسند — و این حافظه را بر کف خانه‌هایشان از هر تبعید و هر روزگاری عبور داده‌اند. این رشته را دنبال کنید.",
    eras: [
      {
        era: "حدود ۴۰۰ پیش از میلاد · دشت‌های سیبری",
        title: "فرش پازیریک",
        text: "کهن‌ترین فرش گره‌بافت جهان در سال ۱۹۴۹ در گوری یخ‌زده در سیبری یافت شد. این فرشِ نزدیک به دوهزاروپانصدساله، با حاشیه سوارکاران و گوزن‌هایش — به شیوه هخامنشی — چنان پخته ترسیم شده که پژوهشگران آن را گواه هنری می‌دانند که قرن‌ها پیش از آن بالیده بود. نخستین فرش بازمانده تاریخ، خود یک شاهکار است.",
      },
      {
        era: "۲۲۴–۶۵۱ میلادی · تیسفون",
        title: "بهارستانِ خسرو",
        text: "در کاخ ساسانی تیسفون، بهارستان گسترده بود — باغی بافته برای زمستان؛ جوی‌هایش از نقره، شکوفه‌هایش از گوهر، تا شاه در میان برف در بهار قدم بزند. چون تیسفون در سال ۶۳۷ سقوط کرد، فاتحان زیبایی‌اش را جز با تکه‌تکه‌کردن نتوانستند قسمت کنند. نامدارترین فرش تاریخ تنها در روایت زنده است — و در همان نقشه باغی که بافندگان ایرانی از آن روز تا امروز بازمی‌بافند.",
      },
      {
        era: "قرن ۲ تا ۹ هجری · بازار و کاروان",
        title: "حافظه در تار و پود",
        text: "در گذر فتوحات و سلسله‌ها، بافندگی میان دربار و روستا و سیاه‌چادر دست‌به‌دست شد. اسلیمی به واژگان نقش راه یافت؛ بته، سرو و درخت زندگی از نگاره‌های کهن به پشم کوچیدند. وقتی کتاب‌ها می‌سوخت، نقش‌ها معنایشان را نگه می‌داشتند؛ فرش متنی است که به‌آسانی مصادره نمی‌شود.",
      },
      {
        era: "۹۰۷–۱۱۴۸ هجری · اصفهانِ صفوی",
        title: "عصر طلایی",
        text: "شاهان صفوی فرش‌بافی را از پیشه به هنر شاهانه برکشیدند و کارگاه‌های سلطنتی در اصفهان و کاشان و تبریز برپا کردند. گواه بزرگِ بازمانده آن دوران، فرش اردبیل است بافته ۹۴۶ هجری (۱۵۳۹ میلادی) — آسمانی گسترده که امروز در موزه ویکتوریا و آلبرت لندن است و امضایی فروتنانه دارد: «مقصود کاشانی، بنده درگاه». کهن‌ترین فرش جهان که تاریخش را بر حاشیه خود بافته است.",
      },
      {
        era: "قرن سیزدهم هجری · کاشان",
        title: "نوزایی و رشته منچستر",
        text: "پس از دهه‌ها رکود، کارگاه‌های استادان کاشان — و پیش از همه محتشم — شیوه کلاسیک را دوباره زنده کردند. پشم درخشانشان از الیاف مرینوسِ وارداتی بود که از راه کارخانه‌های منچستر می‌رسید، و «کاشان منچستر» نامی شد که مجموعه‌داران آهسته بر زبان می‌آورند. دو فرش از همین تبار در مجموعه ما زنده‌اند.",
      },
      {
        era: "دهه ۱۳۱۰ خورشیدی · قم",
        title: "جوان‌ترین شهرِ استادان",
        text: "قم تناقض شیرین فرش ایرانی است: شهری بافنده با عمری به‌زحمت صدساله که یک‌راست بر قله نشست. بافندگانی که از کاشان آمدند کارگاه‌هایی بنیان نهادند که دشوارترین راه را برگزید — ابریشم بر ابریشم و رج‌شمارهای افسانه‌ای — تا «ابریشم قم» خودِ معیار ظرافت شود.",
      },
      {
        era: "۱۳۸۹ خورشیدی · جهان",
        title: "میراث بشریت",
        text: "یونسکو مهارت‌های سنتی فرش‌بافی کاشان و فارس را در فهرست میراث فرهنگی ناملموس بشریت ثبت کرد. آنچه مادربزرگی پای دار قالی می‌آموخت، امروز همان‌گونه پاس داشته می‌شود که کلیساهای جامع و سمفونی‌ها. گرهی که از امپراتوری‌ها جان به در برد، اکنون رسماً گنجینه همه جهان است.",
      },
    ],
    closingTitle: "راز ماندگاری",
    closing:
      "به این سرزمین تاختند، نامش را عوض کردند و راه‌هایش را بستند — و در تمام این سال‌ها فرش، آرام، وطنِ قابل‌حملِ ایرانیان بود. وقتی باغی نیست، باغ را نگه می‌دارد؛ در زمستان، بهار را؛ و نامِ نقش‌هایی را که نخستین راویانشان سه هزار سال است رفته‌اند. داشتن یک فرش، در دست داشتن رشته‌ای از همین پیوند ناگسسته است.",
    toGuide: "خواندن فرش را بیاموزید",
  },
};

const c = content[locale] ?? content.en!;
---

<BaseLayout
  locale={locale}
  path="/history"
  title={`${c.title} — ${ui.siteName}`}
  description={c.intro.slice(0, 155)}
>
  <section class="mx-auto max-w-[800px] px-6 pt-16 text-center">
    <p class="text-xs uppercase tracking-[0.3em] text-saffron" data-reveal>{c.kicker}</p>
    <h1 class="font-display-lang mt-4 text-5xl md:text-6xl" data-reveal>{c.title}</h1>
    <Motif variant="divider" class="mt-6 text-espresso/25" data-reveal />
    <p class="mt-8 text-start text-base leading-loose text-espresso/90" data-reveal>{c.intro}</p>
  </section>

  <!-- The winding timeline: a continuous curve like a rug's branching stem -->
  <section class="mx-auto max-w-[1000px] px-6 py-16">
    <div class="flex flex-col">
      {c.eras.map((item, i) => (
        <div class="grid gap-x-0 md:grid-cols-[1fr_5rem_1fr]">
          {/* connecting curve segment — alternates direction each era */}
          <div class="relative hidden md:col-start-2 md:block">
            <!-- khataei scroll, undistorted: straight guard lines above and
                 below, a fixed-proportion flowering scroll in the middle -->
            <div class="absolute inset-0 flex flex-col items-center">
              <span class="w-px grow bg-espresso/25"></span>
              <svg
                viewBox="0 0 80 280"
                class={`h-[280px] w-20 shrink-0 text-espresso/40 ${i % 2 ? "-scale-x-100" : ""}`}
                fill="none"
                stroke="currentColor"
                stroke-width="1.3"
                aria-hidden="true"
              >
                <!-- stem -->
                <path d="M40 0 C 62 46 18 86 16 140 C 14 194 62 234 40 280" />
                <!-- saz leaf, base on the stem at (43.5,47), tip sweeping up-right -->
                <path d="M43.5 47 C 52 42 61 33 65 22 C 67 31 62 42 53 48 C 49 50.5 46 49.5 43.5 47 Z" />
                <path d="M46 45.5 C 53 40 59 32 62.5 25" />
                <!-- eslimi spiral tendril springing from (31.7,80.6) -->
                <path d="M31.7 80.6 C 22 82 15 88 16 96 C 17 102 24 103 25 97 C 25.5 93 22 91 20 93.5" />
                <!-- peduncle from the stem's widest point to the era palmette -->
                <path d="M16 140 C 11 140 6 140 1 140" />
                <!-- ghoncheh bud on a stemlet at (29.9,199) -->
                <path d="M29.9 199 C 24 202 20 207 19 213" />
                <path d="M19 213 C 15 217 15 223 19 226 C 23 223 23 217 19 213 Z" />
                <path d="M16.5 214.5 C 14.5 212.5 14 210 15 208" />
                <!-- saz leaf, base on the stem at (44,240), tip sweeping down-right -->
                <path d="M44 240 C 52 245.5 60 254 63 265 C 65 255.5 59.5 245.5 51.5 240.5 C 48.5 238.6 46 238.7 44 240 Z" />
                <path d="M47 242.5 C 53 247 58 254 60.5 260.5" />
              </svg>
              <span class="w-px grow bg-espresso/25"></span>
            </div>
            <!-- shah abbasi palmette blossoming from the peduncle toward the era -->
            <svg viewBox="0 0 100 100" fill="none" stroke="currentColor" stroke-width="1.75"
              class={`absolute top-1/2 h-12 w-12 -translate-y-1/2 text-crimson ${i % 2 ? "right-[10px] rotate-90" : "left-[10px] -rotate-90"}`}
              aria-hidden="true">
              <path d="M50 8 C 61 15 67 28 63 41 C 60 52 53 58 50 64 C 47 58 40 52 37 41 C 33 28 39 15 50 8 Z" />
              <path d="M37 41 C 29 39 23 33 21 25 C 29 25 35 30 38.5 36" />
              <path d="M63 41 C 71 39 77 33 79 25 C 71 25 65 30 61.5 36" />
              <path d="M50 22 C 55.5 30 55.5 42 50 50 C 44.5 42 44.5 30 50 22 Z" />
              <path d="M43 62 C 46 68 54 68 57 62" />
            </svg>
          </div>

          <div
            class={`border-s-2 border-espresso/20 ps-6 md:border-0 md:ps-0 ${i % 2 ? "md:col-start-3 md:text-start" : "md:col-start-1 md:text-end"} py-10 md:py-14 md:row-start-1`}
            data-reveal
          >
            <p class="text-xs uppercase tracking-[0.25em] text-saffron">{item.era}</p>
            <h2 class="font-display-lang mt-2 text-3xl md:text-4xl">{item.title}</h2>
            <p class="mt-4 text-sm leading-loose text-espresso/90">{item.text}</p>
          </div>
        </div>
      ))}
    </div>
  </section>

  <section class="px-4 pb-8">
    <div
      class="relative mx-auto max-w-[900px] overflow-hidden rounded-[2.5rem] bg-bitter px-8 py-14 text-center text-canvas"
      data-reveal
    >
      <Motif variant="medallion" class="pointer-events-none absolute -end-24 -top-24 h-80 w-80 text-canvas/[0.06]" />
      <h2 class="font-display-lang text-3xl md:text-4xl">{c.closingTitle}</h2>
      <p class="mx-auto mt-6 max-w-xl text-sm leading-loose text-canvas/80">{c.closing}</p>
      <div class="mt-8 flex flex-wrap items-center justify-center gap-3">
        <Button href={localizedPath(locale, "/guide")} variant="outline-light">{c.toGuide}</Button>
        <Button href={localizedPath(locale, "/products")} variant="primary">{ui.cta.viewCollection}</Button>
      </div>
    </div>
  </section>
</BaseLayout>
