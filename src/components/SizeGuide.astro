---
import { t, type Locale } from "../i18n/ui";

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const ui = t(locale);

// Traditional woven sizes, drawn to scale (1 cm = 1 SVG unit). The zarcharak —
// the house's signature Qom-silk size — is picked out in crimson.
const sizes = [
  { term: "Ghali", fa: "قالی", w: 400, h: 300 },
  { term: "Shesh Metri", fa: "شش‌متری", w: 300, h: 200 },
  { term: "Ghalicheh", fa: "قالیچه", w: 200, h: 130 },
  { term: "Zaronim", fa: "ذرع و نیم", w: 150, h: 100 },
  { term: "Zarcharak", fa: "ذرع و چارک", w: 120, h: 80, accent: true },
  { term: "Kenareh", fa: "کناره", w: 300, h: 60 },
];
const PAD = 12;
const H = 300 + PAD * 2;
const W = 400 + PAD * 2 + 150; // room for edge labels
---

<div class="overflow-x-auto">
  <svg
    viewBox={`0 0 ${W} ${H}`}
    class="mx-auto w-full max-w-[860px] min-w-[560px] text-espresso"
    fill="none"
    aria-hidden="true"
  >
    {sizes.map((s2) => {
      const y = PAD + 300 - s2.h;
      return (
        <g>
          <rect
            x={PAD}
            y={y}
            width={s2.w}
            height={s2.h}
            stroke={s2.accent ? "var(--color-crimson)" : "currentColor"}
            stroke-opacity={s2.accent ? "0.9" : "0.4"}
            stroke-width={s2.accent ? "2" : "1.3"}
          />
          <text
            x={PAD + s2.w + 8}
            y={y + 5}
            font-size="13"
            fill={s2.accent ? "var(--color-crimson)" : "currentColor"}
            fill-opacity={s2.accent ? "1" : "0.75"}
            dominant-baseline="hanging"
            style="font-family: var(--font-display); letter-spacing: 0.04em;"
          >
            {s2.term}
          </text>
          <text
            x={PAD + s2.w + 8}
            y={y + 22}
            font-size="10"
            fill="currentColor"
            fill-opacity="0.5"
            dominant-baseline="hanging"
          >
            {s2.w} × {s2.h} cm · <tspan style="font-family: var(--font-fa-display); font-size: 12px;">{s2.fa}</tspan>
          </text>
        </g>
      );
    })}
  </svg>
</div>
