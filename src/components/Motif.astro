---
/**
 * Minimal monochrome Persian rug motifs, drawn as single-weight line art.
 * Always rendered in currentColor — set opacity/color via the parent's classes
 * so the ornament stays quiet (e.g. text-espresso/20 on cream, text-canvas/10
 * on the dark panel).
 */
interface Props {
  variant: "medallion" | "divider" | "boteh" | "rosette" | "cypress" | "lachak" | "band";
  class?: string;
}
const { variant, class: cls = "" } = Astro.props;
---

{variant === "medallion" && (
  <svg viewBox="0 0 200 200" fill="none" stroke="currentColor" stroke-width="1" class={cls} aria-hidden="true">
    <circle cx="100" cy="100" r="34" />
    <circle cx="100" cy="100" r="62" />
    <circle cx="100" cy="100" r="90" />
    {[0, 45, 90, 135, 180, 225, 270, 315].map((a) => (
      <g transform={`rotate(${a} 100 100)`}>
        <path d="M100 10 C 112 38 112 66 100 96 C 88 66 88 38 100 10 Z" />
        <path d="M100 42 C 105 55 105 70 100 82 C 95 70 95 55 100 42 Z" />
      </g>
    ))}
    <path d="M100 90 L110 100 L100 110 L90 100 Z" />
  </svg>
)}

{variant === "boteh" && (
  <svg viewBox="0 0 100 100" fill="none" stroke="currentColor" stroke-width="1.5" class={cls} aria-hidden="true">
    <path d="M50 88 C 27 77 19 49 33 29 C 41 17 57 12 66 20 C 73 27 71 37 63 39 C 57 40 52 36 53 30" />
    <path d="M50 76 C 35 68 30 50 39 36 C 45 27 55 24 61 29" />
  </svg>
)}

{variant === "rosette" && (
  <svg viewBox="0 0 100 100" fill="none" stroke="currentColor" stroke-width="1.5" class={cls} aria-hidden="true">
    <circle cx="50" cy="50" r="8" />
    {[0, 45, 90, 135, 180, 225, 270, 315].map((a) => (
      <path transform={`rotate(${a} 50 50)`} d="M50 12 C 57 24 57 34 50 42 C 43 34 43 24 50 12 Z" />
    ))}
  </svg>
)}

{variant === "cypress" && (
  <svg viewBox="0 0 60 140" fill="none" stroke="currentColor" stroke-width="1.5" class={cls} aria-hidden="true">
    <path d="M30 128 C 12 110 10 78 18 52 C 24 32 30 20 30 8 C 34 22 40 34 44 52 C 50 78 46 110 30 128 Z" />
    <path d="M30 118 C 20 102 19 76 25 54 C 27 44 30 34 30 26" />
    <path d="M22 132 H 38" />
  </svg>
)}

{variant === "lachak" && (
  <svg viewBox="0 0 120 120" fill="none" stroke="currentColor" stroke-width="1.5" class={cls} aria-hidden="true">
    <path d="M0 0 C 40 6 70 20 84 36 C 100 54 112 84 118 118" />
    <path d="M0 22 C 30 28 52 40 64 54 C 78 70 88 92 96 118" />
    <path d="M0 46 C 22 52 38 62 48 74 C 58 86 66 102 70 118" />
    <path d="M30 30 C 40 26 48 30 50 38 C 52 46 46 52 40 50" />
  </svg>
)}

{variant === "band" && (
  <svg class={cls} height="14" width="100%" aria-hidden="true">
    <defs>
      <pattern id="motif-band" width="28" height="14" patternUnits="userSpaceOnUse">
        <path d="M14 2 L24 7 L14 12 L4 7 Z" fill="none" stroke="currentColor" stroke-width="1" />
        <circle cx="0" cy="7" r="1.4" fill="currentColor" stroke="none" />
        <circle cx="28" cy="7" r="1.4" fill="currentColor" stroke="none" />
      </pattern>
    </defs>
    <rect width="100%" height="14" fill="url(#motif-band)" />
  </svg>
)}

{variant === "divider" && (
  <div class={`flex items-center justify-center gap-4 ${cls}`} aria-hidden="true">
    <span class="h-px w-16 bg-current"></span>
    <svg viewBox="0 0 100 100" fill="none" stroke="currentColor" stroke-width="2" class="h-5 w-5 -scale-x-100">
      <path d="M50 88 C 27 77 19 49 33 29 C 41 17 57 12 66 20 C 73 27 71 37 63 39 C 57 40 52 36 53 30" />
    </svg>
    <svg viewBox="0 0 100 100" fill="none" stroke="currentColor" stroke-width="2" class="h-5 w-5">
      <path d="M50 88 C 27 77 19 49 33 29 C 41 17 57 12 66 20 C 73 27 71 37 63 39 C 57 40 52 36 53 30" />
    </svg>
    <span class="h-px w-16 bg-current"></span>
  </div>
)}
